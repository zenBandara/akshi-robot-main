QWidget{
 background-color:#EAF8FF;
 font-family: Nunito;
}

/* MCQ options */
QPushButton{
 background-color:#FFD166;
 border-radius:30px;
 font-size:26px;
 padding:15px;
 border:5px solid #FF9F1C;
}

/* Hover highlight */
QPushButton:hover{
 background-color:#FFADAD;
 border:5px solid #FF006E;
}

/* Click feedback */
QPushButton:pressed{
 background-color:#FF8FAB;
 border:5px solid #FF006E;
}

/* Volume slider */
QSlider{
 height:30px;
}

/* Volume icon */
QLabel{
 font-size:26px;
 color:#444;
}
