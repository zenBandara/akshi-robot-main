 <property name="styleSheet">
  <string>

QWidget{
 background-color:#EAF8FF;
 font-family: Nunito;
}

/* Title */
QLabel{
 font-size:36px;
 color:#444;
}

/* Button */
QPushButton{
 background-color:#FFD166;
 border-radius:30px;
 font-size:26px;
 padding:18px;
 border:5px solid #FF9F1C;
 min-height:70px;
 color:black;
}

QPushButton:hover{
 background-color:#FFADAD;
 border:5px solid #FF006E;
}

/* Dropdown main box */
QComboBox{
 font-size:26px;
 padding:15px;
 border-radius:15px;
 min-height:70px;
 color:black;
 background:white;
 border:3px solid #FF9F1C;
}

/* Dropdown items */
QComboBox QAbstractItemView{
 font-size:24px;
 color:black;
 padding:15px;
 selection-background-color:#FFD166;
 selection-color:black;
}

/* Dropdown arrow */
QComboBox::drop-down{
 width:40px;
 border-left:2px solid #FF9F1C;
}

  </string>
 </property>

